# Public site config. Nothing here is a secret: NEXT_PUBLIC_* values ship to the browser.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_ANDROID_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Analytics 4 measurement id. Loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=
